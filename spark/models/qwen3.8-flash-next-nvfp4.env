# Qwen3.8-Flash-Next, NVFP4 (RadixArk's modelopt build: ~176B total with the 51B n-gram table, 6B
# active, 512 experts, vision). TESTED: these exact bytes drove two dresser draws on 2026-09-12 and both
# produced a coherent object - spark/results/dresser-flash-next-medium/ is one of them.
#
# NOT served by spark/serve.sh. Stock vLLM cannot fit it on one 121 GB Spark (135 GB of weights). It is
# served by blazux/qwen3.8-Flash-DGX at bd60fcb1b492ca920f74df7462f05da7b6d98f73: the official
# vllm/vllm-openai:qwen38-flash-next@sha256:fc120ece0a388cc0aa1caad4a9f1cd92113484ab7ec2fd0efadd62585be05bf8
# plus 10 patches, built locally as qwen38-flash-dgx:bd60fcb, which mmaps the n-gram table from NVMe so
# ~76-78 GiB sit on the card at 0.80. Run its scripts/serve.sh with PORT=8001, NAME=qwen38-flash and
# EXTRA='--limit-mm-per-prompt {"image":8}', and remove its --restart unless-stopped at once.
#
# TIGHT ON UNIFIED MEMORY WHILE THIS IS SERVING - budget for it. On a 121 GiB Spark this container
# alone left `free -h` reading ~106 GiB used / ~12 GiB free (2026-09-15, container up ~23h, idle).
# That is normal steady state, not a leak - but it means very little headroom for anything else on
# the box: a host-level low-memory guard (this one on a Claude Code background task; the same class
# of thing could be a systemd OOM policy or the kernel OOM killer elsewhere) can kill an unrelated
# background process - including the `articraft generate` client itself if it's backgrounded - while
# this server just sits there fine. If a generation or build vanishes with no error in its own log,
# check `free -h` and whatever killed it before assuming the client or Articraft is at fault; running
# `articraft generate` from a foreground/detached process rather than a memory-managed background
# job avoids it being a target.
# Licence: qwen-community-1.0 (the checkpoint carries it; review it before any use beyond local).
MODEL_STATUS=tested

# The model the server loads, pinned. spark/serve.sh does not read this file's SERVE_* for this model.
SERVE_MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4
SERVE_REVISION=7b719225242aacd3dbd3f9407468c2ee9a9d2594
# demo_dresser.sh sends SERVE_NAME as the model name: blazux's serve.sh serves it under this name.
SERVE_NAME=qwen3.8-flash-next
# Unused here (spark/serve.sh reads them; blazux's serve.sh sets its own):
# SERVE_IMAGE, SERVE_MAX_MODEL_LEN (262144 there), SERVE_GPU_UTIL (0.80), SERVE_MAX_SEQS (4),
# SERVE_TOOL_PARSER (qwen3_coder), SERVE_REASONING_PARSER (qwen3), SERVE_SPECULATIVE (MTP=0 until
# measured), SERVE_LIMIT_MM (passed through EXTRA), SERVE_EXTRA_ARGS.

# --- client: what Articraft sends ----------------------------------------------------------------
ARTICRAFT_OPENROUTER_CONTEXT_WINDOW_TOKENS=262144
ARTICRAFT_OPENROUTER_IMAGES=1
ARTICRAFT_OPENROUTER_MAX_IMAGES=6
ARTICRAFT_OPENROUTER_MAX_OUTPUT_TOKENS=32768
# Its chat template and tokenizer are byte-identical to Qwen3.8-27B's, whose template was measured: by
# default it replays every earlier turn's reasoning into every request (+50,249 tokens at the last turn
# of a recorded 67-turn run); off, it renders within 38 tokens of Qwen3.6's template.
# reasoning_effort: the template's default is xhigh. At low this model ran 98 turns without once calling
#   compile and produced nothing; at medium the same prompt on the same server compiled at turns 63/71/76
#   and ended in final_response with a coherent dresser (6,078 s, 90,510 output tokens).
ARTICRAFT_OPENROUTER_CHAT_TEMPLATE_KWARGS='{"preserve_thinking": false, "reasoning_effort": "medium"}'
# A known cost of that template: the budget's forced close sends enable_thinking=false, which drops the
# reasoning-effort sentence from the system message, so each forced close prefills the context again.
ARTICRAFT_OPENROUTER_THINKING_BUDGET_TOKENS=8192
