# Qwen3.8-27B (Apache-2.0, released 2026-08-14): 27B dense, hybrid attention, native vision, 262k context,
# as Inferact's NVFP4 build: the runner-up to unsloth's, which does not load in this image (its lm_head is
# FP8-quantized).
#
# TESTED: spark/results/dresser-qwen3.8-27b-medium/ was measured with the settings below. What that has
# bought, as of 2026-09-16: FOUR draws of one object (the dresser), on two server instances, all four
# ending in final_response with every automated check passing on every revision - score.py, handles.py
# and a placement read. Of the two a person has reviewed, one was called good with a defect named
# ("top and sides have underlying geometry slightly pushing through") and one was called POOR ("missing
# cavity on drawers"). Two reviews are outstanding. EVERY AUTOMATED CHECK PASSED THE DRAW A PERSON
# CALLED POOR. Read them as a floor, not a verdict.
MODEL_STATUS=tested

# The image the Qwen3.6 results were measured on. It registers Qwen3_5ForConditionalGeneration, the
# checkpoint's quantization, both parsers and a multimodal processor for it (checked offline: 6 of 6); a
# build is known to load only once it has been served.
SERVE_IMAGE=vllm/vllm-openai@sha256:3dbe092ec5b2cef63b6104d33fa75d6ce53a7870962529ada69f78bbbc38e776
# Inferact's NVFP4 (26.4 GB), the vLLM recipe's NVFP4 example: modelopt NVFP4 W4A4 on the transformer's
# linears; the linear-attention input projections, embeddings, lm_head, vision and MTP stay BF16. Its chat
# template and tokenizer are Qwen3.8-27B's own, byte for byte.
SERVE_MODEL=Inferact/Qwen3.8-27B-NVFP4
SERVE_REVISION=6128240ebaf4eaa7bad2b3d1c72c37d677c5f462
SERVE_NAME=qwen
SERVE_MAX_MODEL_LEN=262144
# The footprint the box already carries under Qwen3.6, so the OS keeps the same ~20 GB.
SERVE_GPU_UTIL=0.80
SERVE_MAX_SEQS=4
# Qwen3.8's tool-call markup renders byte-identically to Qwen3.6's (81 of 81 calls in a recorded run).
SERVE_TOOL_PARSER=qwen3_coder
SERVE_REASONING_PARSER=qwen3
# Off: third-party reports of hard reboots with vLLM MTP on DGX Spark for this model.
SERVE_SPECULATIVE=
SERVE_LIMIT_MM='{"image": 8}'
SERVE_EXTRA_ARGS="--trust-remote-code --enable-prefix-caching"

ARTICRAFT_OPENROUTER_CONTEXT_WINDOW_TOKENS=262144
ARTICRAFT_OPENROUTER_IMAGES=1
ARTICRAFT_OPENROUTER_MAX_IMAGES=6
ARTICRAFT_OPENROUTER_MAX_OUTPUT_TOKENS=32768
# Two template settings, both measured on this checkpoint.
# preserve_thinking: Qwen3.8 replays every earlier turn's reasoning into every request by default
#   (+50,249 tokens at the last turn of a recorded 67-turn run). Off, it renders within 38 tokens of
#   Qwen3.6's template.
# reasoning_effort: the template's default is xhigh, and at xhigh one recorded turn that Qwen3.6 answered
#   with ~28 reasoning tokens cost 4,261-8,320 output tokens and 469-925 s here. At medium the same turn
#   cost 546 tokens and 60 s, and still returned its tool calls. Qwen3.6 has no such setting.
ARTICRAFT_OPENROUTER_CHAT_TEMPLATE_KWARGS='{"preserve_thinking": false, "reasoning_effort": "medium"}'
# A known cost: the budget's forced close sends enable_thinking=false, which drops the reasoning-effort
# sentence Qwen3.8 puts at the top of the system message, so the continuation shares 3 tokens with the
# request it continues and the whole context is prefilled again at every forced close.
ARTICRAFT_OPENROUTER_THINKING_BUDGET_TOKENS=8192
