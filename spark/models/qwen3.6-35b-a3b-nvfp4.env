# Qwen3.6-35B-A3B, NVFP4 (35B total, 3B active MoE, vision). Every measurement in spark/results/
# was taken with exactly this file. Sourced by spark/serve.sh (SERVE_*) and spark/demo_dresser.sh
# (ARTICRAFT_*).
MODEL_STATUS=tested

# --- server: vLLM in Docker ------------------------------------------------------------------
# The cu130-nightly tag moves; this digest is the image the results were measured on.
SERVE_IMAGE=vllm/vllm-openai@sha256:3dbe092ec5b2cef63b6104d33fa75d6ce53a7870962529ada69f78bbbc38e776
SERVE_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
SERVE_REVISION=e94a930c8e9b8a7d3763e449289c261c9c7d3e5e
SERVE_NAME=qwen
SERVE_MAX_MODEL_LEN=262144
SERVE_GPU_UTIL=0.80
SERVE_MAX_SEQS=4
SERVE_TOOL_PARSER=qwen3_coder
SERVE_REASONING_PARSER=qwen3
# MTP-2 speculative decoding. MTP-3 measured +7.6% more, not worth it.
SERVE_SPECULATIVE='{"method":"qwen3_next_mtp","num_speculative_tokens":2}'
# Images per request. Keep it above ARTICRAFT_OPENROUTER_MAX_IMAGES.
SERVE_LIMIT_MM='{"image": 8}'
SERVE_EXTRA_ARGS="--trust-remote-code --enable-prefix-caching"

# --- client: what Articraft sends -------------------------------------------------------------
ARTICRAFT_OPENROUTER_CONTEXT_WINDOW_TOKENS=262144
ARTICRAFT_OPENROUTER_IMAGES=1
# Keep the reference image plus the 5 most recent.
ARTICRAFT_OPENROUTER_MAX_IMAGES=6
# The server bounds nothing; an uncapped thinking turn ran ~49k tokens with no tool call.
ARTICRAFT_OPENROUTER_MAX_OUTPUT_TOKENS=32768
# Thinking stays ON (the template default). With '{"enable_thinking": false}' runs are much faster
# and still pass the joint count, but the geometry does not hold together. See spark/results/.
ARTICRAFT_OPENROUTER_CHAT_TEMPLATE_KWARGS=
# Thinking may spend this many tokens per turn; then the client closes the think block and the model
# acts on the plan it has. Without it Qwen reasoned to the 32k cap three turns running and never acted.
ARTICRAFT_OPENROUTER_THINKING_BUDGET_TOKENS=8192
