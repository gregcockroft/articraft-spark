# Qwen3.8-27B (Apache-2.0, released 2026-08-14): 27B, hybrid attention, native vision, 262k context.
# UNTESTED. Nothing in spark/results/ was measured with this file. It is the slot for the next
# model, not a claim that it works. Fields marked CHECK are unverified guesses.
MODEL_STATUS=untested

SERVE_IMAGE=vllm/vllm-openai@sha256:3dbe092ec5b2cef63b6104d33fa75d6ce53a7870962529ada69f78bbbc38e776
# The BF16 release, about 54 GB. A quantized checkpoint (NVFP4 about 16 GB) decodes faster; set
# its repo id here once you have picked one.
SERVE_MODEL=Qwen/Qwen3.8-27B
# Pin this after the first successful serve (the hub revision you actually downloaded).
SERVE_REVISION=
SERVE_NAME=qwen
SERVE_MAX_MODEL_LEN=262144
SERVE_GPU_UTIL=0.80
SERVE_MAX_SEQS=4
SERVE_TOOL_PARSER=qwen3_coder        # CHECK
SERVE_REASONING_PARSER=qwen3         # CHECK
# Off: third-party reports of hard reboots with vLLM MTP on DGX Spark for this model.
SERVE_SPECULATIVE=
SERVE_LIMIT_MM='{"image": 8}'
SERVE_EXTRA_ARGS="--trust-remote-code --enable-prefix-caching"

ARTICRAFT_OPENROUTER_CONTEXT_WINDOW_TOKENS=262144
ARTICRAFT_OPENROUTER_IMAGES=1
ARTICRAFT_OPENROUTER_MAX_IMAGES=6
ARTICRAFT_OPENROUTER_MAX_OUTPUT_TOKENS=32768
ARTICRAFT_OPENROUTER_CHAT_TEMPLATE_KWARGS=
