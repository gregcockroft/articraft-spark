# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENROUTER_API_KEY=...
# ARTICRAFT_PROVIDER=openai
# ARTICRAFT_MODEL=gpt-6-astra
# ARTICRAFT_REASONING_EFFORT=high
# ARTICRAFT_OPENAI_MAX_ATTEMPTS=4
# ARTICRAFT_OPENAI_REQUEST_TIMEOUT_SECONDS=900
# ARTICRAFT_ANTHROPIC_MODEL=claude-sonnet-5
# ARTICRAFT_ANTHROPIC_MAX_ATTEMPTS=4
# ARTICRAFT_ANTHROPIC_REQUEST_TIMEOUT_SECONDS=3600
# ARTICRAFT_GEMINI_MODEL=gemini-3.6-flash
# ARTICRAFT_GEMINI_MAX_ATTEMPTS=4
# ARTICRAFT_GEMINI_REQUEST_TIMEOUT_SECONDS=900
# ARTICRAFT_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ARTICRAFT_OPENROUTER_MAX_ATTEMPTS=4
# ARTICRAFT_OPENROUTER_REQUEST_TIMEOUT_SECONDS=900
# ARTICRAFT_OPENROUTER_CONTEXT_WINDOW_TOKENS=131072
# ARTICRAFT_OPENROUTER_SUMMARY_MAX_OUTPUT_TOKENS=8192
# OPENROUTER_HTTP_REFERER=...
# OPENROUTER_APP_TITLE=articraft
# ARTICRAFT_COMPILE_TIMEOUT_SECONDS=900
# ARTICRAFT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ARTICRAFT_OPENROUTER_IMAGES=0
#
# Local OpenAI-compatible server (vLLM, llama.cpp, Ollama). No API key is needed;
# set ARTICRAFT_OPENROUTER_IMAGES=1 only if the served model accepts images.
# ARTICRAFT_PROVIDER=openrouter
# ARTICRAFT_OPENROUTER_BASE_URL=http://localhost:8001/v1
# ARTICRAFT_OPENROUTER_MODEL=qwen
# ARTICRAFT_OPENROUTER_CONTEXT_WINDOW_TOKENS=262144
# ARTICRAFT_OPENROUTER_IMAGES=1
# ARTICRAFT_OPENROUTER_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}
# Reasoning models served locally can think to the output cap without acting. A budget
# streams each turn and, once reasoning alone has spent it, closes the think block and
# has the model answer from the thinking it has. 0 leaves turns unbounded.
# ARTICRAFT_OPENROUTER_THINKING_BUDGET_TOKENS=8192
